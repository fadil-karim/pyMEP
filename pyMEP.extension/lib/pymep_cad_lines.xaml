<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy CAD Lines"
        Width="600" Height="700" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Copy CAD Lines"/>
                <TextBlock x:Name="TxtCad" Style="{StaticResource Hint}" Text=""/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14,12,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Layers to copy">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFind" Grid.Column="0" TextChanged="on_find" ToolTip="type to find layers by any words of their name"/>
                        <Button Grid.Column="1" Content="Tick shown" Style="{StaticResource SmallButton}" Click="on_all" Margin="6,3,0,0"/>
                        <Button Grid.Column="2" Content="Untick shown" Style="{StaticResource SmallButton}" Click="on_none" Margin="6,3,0,0"/>
                    </Grid>
                    <DataGrid x:Name="GridLayers" Grid.Row="1" Margin="0,8,0,0" MinHeight="160"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Pick, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Lines" Binding="{Binding Lines}" IsReadOnly="True" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TxtCount" Grid.Row="2" Style="{StaticResource Hint}" Text=""/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Line style">
                <StackPanel>
                    <ComboBox x:Name="CmbStyle"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Every copied line takes this Revit line style (Manage &gt; Additional Settings &gt; Line Styles makes more)."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Make">
                <StackPanel>
                    <RadioButton x:Name="RadDetail" GroupName="mode" IsChecked="True" Checked="on_mode" Margin="0,2,0,0"
                                 Content="Detail lines in the active view"/>
                    <TextBlock x:Name="TxtDetailHint" Style="{StaticResource Hint}" Margin="22,2,0,0" Text=""/>
                    <RadioButton x:Name="RadModel" GroupName="mode" Checked="on_mode" Margin="0,8,0,0"
                                 Content="Model lines on a level"/>
                    <Grid Margin="22,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Level"/>
                        <ComboBox x:Name="CmbLevel" Grid.Column="1"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                               Text="The lines are laid flat on the level (detail lines: on the view's plane) - a CAD line with heights becomes straight segments in plan."/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
        </Grid>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCopy" Content="Copy lines"
                        Style="{StaticResource DialogButton}" IsDefault="True" Click="on_copy"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True" Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
