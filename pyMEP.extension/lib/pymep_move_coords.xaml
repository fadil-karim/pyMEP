<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move to Coordinates"
        Width="700" Height="700" MinWidth="600" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Move to Coordinates"/>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource Hint}" Text=""/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,0">
            <StackPanel>
                <GroupBox Header="1. Selected elements">
                    <StackPanel>
                        <ListBox x:Name="LstElements" Height="130" FontFamily="Consolas" FontSize="12"
                                 SelectionChanged="on_changed"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Each line shows the element, the point it is measured at (its location point, the start of a curve, or the centre of its box) and where that point is now. With one target line, the HIGHLIGHTED element lands on it and the others move with it, keeping their spacing."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2. Where to">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Coordinates are"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbSystem" SelectionChanged="on_changed"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Units"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbUnits" SelectionChanged="on_changed"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="x, y[, z]" VerticalAlignment="Top" Margin="0,10,10,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtPoints" Height="90" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 FontFamily="Consolas" Margin="0,3,0,0" TextChanged="on_changed"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}"
                                   Text="One line moves everything together. One line per element pairs them in list order. Lines starting with a Mark (P1605, 12.5, 8.0) move that element. z is the new offset above the element's level; without it the height stays. 2D elements (regions, annotations) only move in x, y."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="What will happen">
                    <StackPanel>
                        <TextBox x:Name="TxtPlan" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="120"
                                 AcceptsReturn="True" TextWrapping="NoWrap" Background="#FAFAFA"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                        <CheckBox x:Name="ChkUnpin" Margin="0,10,0,0" Content="unpin pinned elements so they can move"/>
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="StatusText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnMove" Content="Move"
                        Style="{StaticResource DialogButton}" IsDefault="True" Click="on_move"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True" Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
