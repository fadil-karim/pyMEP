<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bridge Builder - the two ends"
        Width="680" Height="640" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Bridge Builder"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="A bridge runs between two generic model instances. Say which family types mark the start and the end and which of their parameters holds the deck level there; the builder page then opens in your browser with the span and levels filled in."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,0">
            <StackPanel>
                <GroupBox Header="Bridge">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Name"/>
                        <TextBox Grid.Column="1" x:Name="TxtName"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Start point">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Search"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtStartSearch" TextChanged="on_start_search"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Family : Type"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbStart" SelectionChanged="on_type_changed"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtStartInfo" Style="{StaticResource Hint}" Text=""/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="End point">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Search"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtEndSearch" TextChanged="on_end_search"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Family : Type"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbEnd" SelectionChanged="on_type_changed"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtEndInfo" Style="{StaticResource Hint}" Text=""/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Deck level at each end">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Level parameter"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbParam" SelectionChanged="on_param_changed"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Its value is"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbMode" SelectionChanged="on_param_changed"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtParamInfo" Style="{StaticResource Hint}"
                                   Text="A length parameter reads in its own units; a plain number or text reads as metres. The first option also offers the instance's own elevation."/>
                    </Grid>
                </GroupBox>

                <TextBlock x:Name="StatusText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnOpen" Content="Open Bridge Builder"
                        Style="{StaticResource DialogButton}" IsDefault="True" Click="on_open"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True" Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
